{
  "name": "Azure-Devops",
  "description": "Cloud-Native Computing Project",
  "author": "Muhammad Ahsan, Talha Ahmed, Abdul Wahid, Kanwal Yousaf, Alina Khan",
  "version": "0.0.1",
  "main": "index.ts",
  "scripts": {
    "build": "npx tsc --outDir build && echo Build created successfully in ./build",
    "start": "cross-env NODE_ENV=local node -r ./register-aliases.js ./build/index.js",
    "start:production": "cross-env NODE_ENV=production node -r ./register-aliases.js ./build/index.js",
    "start:local": "cross-env NODE_ENV=local node -r ./register-aliases.js ./build/index.js",
    "start:qa": "cross-env NODE_ENV=qa node -r ./register-aliases.js ./build/index.js",
    "start:staging": "cross-env NODE_ENV=staging node -r ./register-aliases.js ./build/index.js",
    "dev": "cross-env NODE_ENV=local concurrently \"tsc -w\" \"nodemon -e js,env --watch environments --exec \\\"node -r ./register-aliases.js\\\" ./build/index.js\"",
    "dev:qa": "cross-env NODE_ENV=qa concurrently \"tsc -w\" \"nodemon -e js,env --watch environments --exec \\\"node -r ./register-aliases.js\\\" ./build/index.js\"",
    "dev:staging": "cross-env NODE_ENV=staging concurrently \"tsc -w\" \"nodemon -e js,env --watch environments --exec \\\"node -r ./register-aliases.js\\\" ./build/index.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "mongodb": "^6.21.0",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
